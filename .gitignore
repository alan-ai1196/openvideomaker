# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
out/
# ...but the app icon sources are part of the product identity:
# un-ignore the desktop buildResources dir, then re-ignore its caches.
!apps/desktop/build/
apps/desktop/build/*
!apps/desktop/build/icon.svg
!apps/desktop/build/icon.png
!apps/desktop/build/icon.ico
apps/desktop/build/.icon-ico/
release/
.turbo/
*.tsbuildinfo

# tests
coverage/

# research caches (never commit upstream clones)
.research/

# astro dev cache
apps/site/.astro/

# environments / runtimes
.venv/
venv/
__pycache__/
*.pyc
.pixi/
uv.lock

# logs & OS junk
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

# local env / secrets
.env
.env.*
!.env.example

# editor
.idea/
.vscode/*
!.vscode/extensions.json

# product runtime artifacts (never commit user projects/media)
project.ovm/
.ovm/
ovm-cache/
