{
  "name": "@openvideomaker/media",
  "version": "0.1.0",
  "private": true,
  "description": "Media indexing: ffprobe metadata, filmstrip thumbnails, waveform peaks.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/vitest.mjs run",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@openvideomaker/schema": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
