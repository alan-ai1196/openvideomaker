{
  "name": "@openvideomaker/studio",
  "version": "0.1.0",
  "private": true,
  "description": "OpenVideoMaker Studio - the primary React editing application.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/vitest.mjs run",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@openvideomaker/core": "workspace:*",
    "@openvideomaker/schema": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@openvideomaker/registry": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
