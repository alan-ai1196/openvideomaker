{
  "name": "@openvideomaker/persistence",
  "version": "0.1.0",
  "private": true,
  "description": "Durable project storage: SQLite-backed snapshot + append-only operation log with crash-safe saves.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/vitest.mjs run",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@openvideomaker/core": "workspace:*",
    "@openvideomaker/schema": "workspace:*",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
